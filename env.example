# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/fast-food-app

# JWT Secret (générez une clé sécurisée pour la production)
JWT_SECRET=votre-secret-jwt-tres-long-et-securise-pour-le-developpement

# URL de l'application
NEXTAUTH_URL=http://localhost:3000

# Mode de développement
NODE_ENV=development
